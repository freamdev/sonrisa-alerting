# Reference only: ASP.NET Core reads environment variables, not .env files.
# Set these in your shell or IDE. Identity requires a migrated PostgreSQL database.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5165
ConnectionStrings__Alerts=Host=localhost;Port=5432;Database=alerts;Username=YOUR_LOCAL_USER;Password=YOUR_LOCAL_PASSWORD
# Opt in only for Development, after applying the Identity migration.
DevelopmentSeed__Enabled=false
DevelopmentSeed__AdminEmail=admin@example.test
DevelopmentSeed__AdminPassword=REPLACE_WITH_A_UNIQUE_LOCAL_PASSWORD
DevelopmentSeed__UserEmail=user@example.test
DevelopmentSeed__UserPassword=REPLACE_WITH_A_DIFFERENT_UNIQUE_LOCAL_PASSWORD
