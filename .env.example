# Docker Compose loads .env; dotnet run does not. See docs/phase03-compose.md.
# Replace this placeholder before starting. Use a unique local password containing
# letters/digits/symbols, but no double quotes or newlines (connection-string quoting).
# Single-quote values in .env if they contain $ or # to prevent interpolation/comments.
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_LOCAL_DB_PASSWORD
API_PORT=5165
FRONTEND_PORT=4200
# Accounts are opt-in. Set true and replace BOTH password placeholders to test auth.
DevelopmentSeed__Enabled=false
DevelopmentSeed__AdminEmail=admin@example.test
DevelopmentSeed__AdminPassword=REPLACE_WITH_A_UNIQUE_LOCAL_ADMIN_PASSWORD
DevelopmentSeed__UserEmail=user@example.test
DevelopmentSeed__UserPassword=REPLACE_WITH_A_DIFFERENT_UNIQUE_LOCAL_USER_PASSWORD

# Phase 05: docker compose --profile channels up --build starts the local mail sink.
# SMTP None is permitted only in Development. Use StartTls or SslOnConnect for a relay.
Channels__Email__Host=mailpit
Channels__Email__Port=1025
Channels__Email__Security=None
Channels__Email__From=alerts@example.test
Channels__Email__Username=
Channels__Email__Password=
MAILPIT_UI_PORT=8025
# Secret JSON mapping application user IDs to incoming webhooks. No global fallback.
# Keep the outer single quotes for Compose. Replace USER_ID and URL locally only.
Channels__Slack__WebhooksJson='{}'
# Example shape: '{"USER_ID":"https://hooks.slack.com/services/REPLACE/LOCALLY/ONLY"}'
Channels__Slack__AllowLocalMock=false

# Phase 06: opt in after configuring user selections and destinations.
# Compose polls its Development-only route; host-run default is localhost:5165.
NewsSource__Enabled=false
NewsSource__IntervalSeconds=30
NewsSource__TimeoutSeconds=10
# Host-run overrides: NewsSource__Endpoint and NewsSource__FixturePath.
# Compose mounts src/Alerts.Api/Fixtures read-only; edit news.json on the host.

# For dotnet run only, set these in the shell/IDE instead of copying into .env:
# ASPNETCORE_ENVIRONMENT=Development
# ConnectionStrings__Alerts=Host=localhost;Port=5432;Database=alerts;Username=YOUR_LOCAL_USER;Password=YOUR_LOCAL_PASSWORD
